{
  "name": "codex-plugin-cc",
  "version": "2.1.1",
  "private": true,
  "description": "Use Codex from Claude Code to review code or delegate tasks.",
  "license": "Apache-2.0",
  "type": "module",
  "scripts": {
    "bump-version": "node scripts/bump-version.ts",
    "check-version": "node scripts/bump-version.ts --check",
    "lint": "oxlint --type-aware --deny-warnings",
    "lint:fix": "oxlint --type-aware --fix",
    "fmt": "oxfmt --check",
    "fmt:fix": "oxfmt",
    "typecheck": "tsc",
    "test": "node --test tests/*.test.ts",
    "test:cli-contract": "CODEX_CLI_CONTRACT=1 node --test tests/cli-contract.test.ts"
  },
  "devDependencies": {
    "@commitlint/cli": "21.2.4",
    "@commitlint/config-conventional": "21.2.4",
    "@types/node": "24.19.2",
    "lefthook": "2.2.2",
    "oxfmt": "0.71.0",
    "oxlint": "1.88.0",
    "oxlint-tsgolint": "7.0.2006",
    "typescript": "7.0.2"
  },
  "engines": {
    "node": "24.x"
  }
}
