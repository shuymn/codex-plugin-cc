{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": ["typescript", "unicorn", "oxc", "import"],
  "categories": {
    "correctness": "error",
    "suspicious": "error"
  },
  "options": {
    "typeAware": true
  },
  "ignorePatterns": [
    // Legacy .mjs code; the TypeScript rewrite replaces it and removes these exclusions.
    "plugins/codex/scripts/**/*.mjs",
    "plugins/codex/scripts/**/*.d.ts",
    "scripts/**/*.mjs",
    "tests/**/*.mjs"
  ]
}
