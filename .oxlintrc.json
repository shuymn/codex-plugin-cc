{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": ["typescript", "unicorn", "oxc", "import"],
  "categories": {
    "correctness": "error",
    "suspicious": "error"
  },
  "options": {
    "typeAware": true
  },
  "overrides": [
    {
      // node:test runs the promise that test() returns, so the tests do not await it.
      // Tests cast fixture JSON they wrote themselves.
      "files": ["tests/**/*.ts"],
      "rules": {
        "typescript/no-floating-promises": "off",
        "typescript/no-unsafe-type-assertion": "off"
      }
    }
  ],
  "ignorePatterns": [
    // Legacy .mjs code; the TypeScript rewrite replaces it and removes these exclusions.
    "plugins/codex/scripts/**/*.mjs",
    "plugins/codex/scripts/**/*.d.ts",
    "scripts/**/*.mjs",
    "tests/**/*.mjs"
  ]
}
